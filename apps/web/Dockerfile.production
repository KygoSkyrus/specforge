# Production Dockerfile for SpecForge Web (Next.js)

FROM node:20.14-alpine AS base
RUN apk add --no-cache ca-certificates openssl
WORKDIR /app

FROM base AS dependencies
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN npm install -g pnpm@9.15.0 && pnpm install --frozen-lockfile --prod

FROM base AS builder
RUN npm install -g pnpm@9.15.0
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build --filter=@specforge/web

FROM node:20.14-alpine AS runtime
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
WORKDIR /app

ENV NODE_ENV=production
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=builder /app/apps/web/.next ./.next
COPY --from=builder /app/apps/web/public ./public
COPY --from=builder /app/apps/web/package.json ./

RUN chown -R nodejs:nodejs /app
USER nodejs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1

LABEL org.opencontainers.image.title="SpecForge Web"
LABEL org.opencontainers.image.version="1.0.0"

CMD ["node_modules/.bin/next", "start", "-p", "3000"]
