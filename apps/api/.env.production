# Production Environment Configuration
# Copy to .env.production and fill in secrets

# ============================================================================
# Application
# ============================================================================
NODE_ENV=production
PORT=3001
CORS_ORIGIN=https://specforge.app,https://www.specforge.app
ENVIRONMENT=production

# ============================================================================
# Database
# ============================================================================
DATABASE_URL=postgresql://user:password@specforge-db-prod.postgres.database.azure.com:5432/specforge?sslmode=require
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_QUERY_TIMEOUT_MS=10000

# ============================================================================
# Redis
# ============================================================================
REDIS_URL=rediss://:password@specforge-redis-prod.redis.cache.windows.net:6379/0
REDIS_POOL_SIZE=10
REDIS_SOCKET_KEEPALIVE_INTERVAL=30000

# ============================================================================
# Authentication
# ============================================================================
JWT_SECRET=your-rs256-private-key-here
JWT_PUBLIC_KEY=your-rs256-public-key-here
JWT_EXPIRY=900 # 15 minutes
REFRESH_TOKEN_EXPIRY=2592000 # 30 days
SESSION_SECRET=your-session-secret-here

AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-oauth-secret
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-secret

NEXTAUTH_URL=https://specforge.app
NEXTAUTH_SECRET=your-nextauth-secret-here

# ============================================================================
# LLM & AI
# ============================================================================
OPENAI_API_KEY=sk-proj-xxxxx
OPENAI_ORG_ID=org-xxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_MODEL_FRONTIER=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_REQUEST_TIMEOUT_MS=60000

# ============================================================================
# AI Cost Control
# ============================================================================
AI_ORG_MONTHLY_BUDGET_USD=5000
AI_ORG_BUDGET_WARN_THRESHOLD_PCT=80
AI_ORG_BUDGET_HARD_STOP_ENABLED=true
AI_COST_TRACKING_ENABLED=true

# ============================================================================
# Storage
# ============================================================================
S3_BUCKET=specforge-prod-uploads
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_UPLOAD_MAX_SIZE_MB=50
S3_SIGNED_URL_EXPIRY_SECONDS=3600

# ============================================================================
# Integrations
# ============================================================================
LINEAR_OAUTH_CLIENT_ID=your-linear-oauth-client-id
LINEAR_OAUTH_CLIENT_SECRET=your-linear-oauth-secret
LINEAR_OAUTH_REDIRECT_URI=https://api.specforge.app/api/v1/integrations/linear/callback

TRELLO_APP_KEY=your-trello-app-key
TRELLO_APP_SECRET=your-trello-app-secret

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_ID=your-slack-app-id

JIRA_OAUTH_CLIENT_ID=your-jira-client-id
JIRA_OAUTH_CLIENT_SECRET=your-jira-client-secret

# ============================================================================
# Notifications
# ============================================================================
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=your-resend-api-key
SMTP_FROM=noreply@specforge.app
NOTIFICATION_ENABLED=true
NOTIFICATION_SMTP_ENABLED=true
NOTIFICATION_SLACK_ENABLED=true
NOTIFICATION_IN_APP_ENABLED=true

# ============================================================================
# Security & Secrets
# ============================================================================
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-for-secrets
SECRET_ROTATION_INTERVAL_DAYS=30
CORS_CREDENTIALS=true
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# Observability & Monitoring
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
OTEL_ENABLED=true
OTEL_COLLECTOR_URL=https://tempo-ingestor.observability.svc.cluster.local:4317
METRICS_ENABLED=true
METRICS_PORT=9090
TRACE_SAMPLE_RATE=0.1
APM_ENABLED=true

# Sentry for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# Datadog (optional APM)
# ============================================================================
DD_ENV=production
DD_SERVICE=specforge-api
DD_VERSION=1.0.0
DD_API_KEY=your-datadog-api-key
DD_TRACE_ENABLED=true

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_DEAL_ROOM_ENABLED=true
FEATURE_INTEGRATIONS_ENABLED=true
FEATURE_REVIEW_PACKS_ENABLED=true
FEATURE_DIAGRAMS_ENABLED=true
FEATURE_COLLABORATION_ENABLED=false

# ============================================================================
# URL Configuration
# ============================================================================
API_BASE_URL=https://api.specforge.app/api/v1
WEB_BASE_URL=https://specforge.app
DEAL_ROOM_BASE_URL=https://specforge.app/d
SHARE_LINK_BASE_URL=https://specforge.app/share

# ============================================================================
# Kubernetes / Infrastructure
# ============================================================================
ENVIRONMENT_NAME=production
CLUSTER_NAME=specforge-prod-aks
NAMESPACE=default
DEPLOYMENT_VERSION=1.0.0

# ============================================================================
# Backups & Disaster Recovery
# ============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_ENABLED=true
RESTORE_POINT_RETENTION_DAYS=7

# ============================================================================
# Compliance & Audit
# ============================================================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
GDPR_PII_REDACTION_ENABLED=true
COMPLY_WITH_SOC2=true
COMPLY_WITH_HIPAA=false
