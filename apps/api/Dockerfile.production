# Production Dockerfile for SpecForge API
# Multi-stage build for minimal image size and security

FROM node:20.14-alpine AS base
# Install build dependencies
RUN apk add --no-cache python3 make g++ ca-certificates openssl
WORKDIR /app

FROM base AS dependencies
# Copy lock files
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN npm install -g pnpm@9.15.0 && pnpm install --frozen-lockfile --prod

FROM base AS builder
# Install pnpm
RUN npm install -g pnpm@9.15.0
# Copy all source
COPY . .
# Install all dependencies (including devDeps for build)
RUN pnpm install --frozen-lockfile
# Build the API
RUN pnpm build --filter=@specforge/api
# Generate Prisma client
RUN pnpm db:generate --filter=@specforge/api

FROM node:20.14-alpine AS runtime
# Security: Add non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001
WORKDIR /app

# Copy only production dependencies from dependencies stage
COPY --from=dependencies /app/node_modules ./node_modules

# Copy built app from builder
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/package.json ./
COPY --from=builder /app/apps/api/prisma ./prisma

# Change ownership
RUN chown -R nodejs:nodejs /app

# Security: Use non-root user
USER nodejs

# Expose port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/api/v1/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))" || exit 1

# Use tini to handle signals properly
RUN npm install -g tini
ENTRYPOINT ["/sbin/tini", "--"]

# Start application
CMD ["node", "dist/main.js"]

# Labels for metadata
LABEL org.opencontainers.image.title="SpecForge API"
LABEL org.opencontainers.image.description="AI-powered spec management platform API"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.source="https://github.com/specforge/specforge"
LABEL org.opencontainers.image.authors="Dheeraj Gupta"
