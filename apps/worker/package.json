    "@specforge/domain": "workspace:*",
    "@specforge/prompts": "workspace:*",
    "@specforge/schemas": "workspace:*",
    "bullmq": "^5.44.0",
    "ioredis": "^5.6.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
